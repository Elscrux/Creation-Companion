<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CreationEditor.Avalonia.ViewModels.Config.Options"
             mc:Ignorable="d"
             d:DesignWidth="400"
             d:DesignHeight="100"
             x:DataType="vm:ColorConfigOptionVM"
             x:Class="CreationEditor.Avalonia.Views.Config.Options.ColorConfigOptionView">
    <ColorPicker Color="{Binding Color}"/>
</UserControl>