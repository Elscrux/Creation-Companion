<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behavior="clr-namespace:CreationEditor.Avalonia.Behavior"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:docking="clr-namespace:CreationEditor.Avalonia.ViewModels.Docking"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="CreationEditor.Avalonia.Views.Docking.Tab"
             x:Name="Control"
             x:DataType="docking:DockedItemVM">
    <Interaction.Behaviors>
        <behavior:DockDragBehavior/>
        <behavior:TabReorderBehavior DockContainer="{Binding #Control.DockContainer}"/>
    </Interaction.Behaviors>

    <!-- <UserControl.Styles>
        <Style Selector="controls|FASymbolIcon">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="Foreground" Value="Blue" />
        </Style>

        <Style Selector="controls|FAFontIcon">
            <Setter Property="Width" Value="20"/>
        </Style>
    </UserControl.Styles> -->

    <Border Classes="Tab"
           
            Classes.AccentSelected="{Binding IsSelected}"
            PointerReleased="OnTabPointerReleased"
            ToolTip.Tip="{Binding Header}">

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <!-- Icon -->
            <!-- <controls:FAIconSourceElement Margin="4,0,0,0"
                                          IsVisible="{Binding IconSource, Converter={x:Static ObjectConverters.IsNotNull}}"
                                          IconSource="{Binding IconSource}">
                <controls:FAIconSourceElement.Styles>
                    <Style Selector="controls|FASymbolIcon">
                        <Setter Property="FontSize" Value="30"/>
                    </Style>

                    <Style Selector="controls|FAFontIcon">
                        <Setter Property="FontSize" Value="30"/>
                    </Style>
                </controls:FAIconSourceElement.Styles>
            </controls:FAIconSourceElement> -->

            <!-- kemor: swapped to ViewBox which actually respects changed values -->
            <Viewbox Width="32" Height="32"
                    IsVisible="{Binding IconSource, Converter={x:Static ObjectConverters.IsNotNull}}">
                
                <controls:FAIconSourceElement IconSource="{Binding IconSource}" VerticalAlignment="Center" />
                
            </Viewbox>

            <!-- Header -->
            <!-- <TextBlock Text="{Binding Header}"/> -->

            <!-- Close -->
            <!-- <Button Classes="DockClose"
                    Command="{Binding CloseCommand}"
                    IsVisible="{Binding CanClose}">
                <controls:FASymbolIcon Symbol="Dismiss"
                                       ToolTip.Tip="Close"/>
            </Button> -->
        </StackPanel>
    </Border>
</UserControl>