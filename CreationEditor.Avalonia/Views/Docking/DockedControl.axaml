<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:view="clr-namespace:CreationEditor.Avalonia.Views.Docking"
             xmlns:model="clr-namespace:CreationEditor.Avalonia.Models.Docking"
             xmlns:behavior="clr-namespace:CreationEditor.Avalonia.Behavior"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:DataType="model:IDockedItem"
             x:Class="CreationEditor.Avalonia.Views.Docking.DockedControl"
             Background="{DynamicResource SystemControlTransparentBrush}"
             Classes="AccentSelected BorderedDock">
    <Interaction.Behaviors>
        <behavior:DockDropBehavior DockContainer="{Binding DockParent}"/>
    </Interaction.Behaviors>

    <DockPanel>
        <Border x:Name="DockTitleBar"
                DockPanel.Dock="Top"
                CornerRadius="2"
                Padding="2,0"
                MaxHeight="25">
            <Interaction.Behaviors>
                <behavior:DockDragBehavior/>
            </Interaction.Behaviors>

            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="4">
                <!-- Icon -->
                <controls:FAIconSourceElement Grid.Column="0"
                                              Margin="4, 0,0,0"
                                              IsVisible="{Binding IconSource, Converter={x:Static ObjectConverters.IsNotNull}}"
                                              IconSource="{Binding IconSource}">
                    <controls:FAIconSourceElement.Styles>
                        <Style Selector="controls|FASymbolIcon">
                            <Setter Property="FontSize"
                                    Value="20"/>
                        </Style>

                        <Style Selector="controls|FAFontIcon">
                            <Setter Property="FontSize"
                                    Value="20"/>
                        </Style>
                    </controls:FAIconSourceElement.Styles>
                </controls:FAIconSourceElement>

                <!-- Header -->
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="{Binding Header}"/>

                <!-- Close -->
                <Button Grid.Column="2"
                        Classes="DockClose"
                        HorizontalAlignment="Right"
                        Command="{Binding CloseCommand}"
                        IsVisible="{Binding CanClose}">
                    <controls:FASymbolIcon Symbol="Dismiss"
                                           ToolTip.Tip="Close"/>
                </Button>
            </Grid>
        </Border>

        <ContentControl Content="{Binding $parent[view:DockedControl].Control}"/>
    </DockPanel>
</UserControl>