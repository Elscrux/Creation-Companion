<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:model="clr-namespace:CreationEditor.Avalonia.Models.Docking"
             xmlns:vm="clr-namespace:CreationEditor.Avalonia.ViewModels.Docking"
             xmlns:behavior="clr-namespace:CreationEditor.Avalonia.Behavior"
             xmlns:controls="using:FluentAvalonia.UI.Controls"
             xmlns:docking="clr-namespace:CreationEditor.Avalonia.Views.Docking"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:SideDockVM"
             x:Class="CreationEditor.Avalonia.Views.Docking.SideDockRight"
             x:Name="Dock"
             Classes="BorderedDockContainer">
    <Interaction.Behaviors>
        <behavior:DockDropBehavior DockContainer="{Binding}"/>
    </Interaction.Behaviors>

    <Grid ColumnDefinitions="*,Auto"
        Classes="AccentSelected TabGrid">
        <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <Border Grid.Row="0" 
                    VerticalAlignment="Center"
                    Padding="0,4"
                    Background="{DynamicResource ButtonBackground}"
                    CornerRadius="3,0">
                <StackPanel Orientation="Horizontal" 
                            Spacing="4"
                            Margin="6,4,0,0"
                            IsVisible="{Binding ActiveTab.IconSource, Converter={x:Static ObjectConverters.IsNotNull}}"
                >
                    <Viewbox Width="14" Height="14"
                            IsVisible="{Binding ActiveTab.IconSource, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <controls:FAIconSourceElement IconSource="{Binding ActiveTab.IconSource}" />  
                    </Viewbox>
                
                    <TextBlock Text="{Binding ActiveTab.Header}" 
                                FontSize="14" 
                                FontWeight="Medium"
                    />

                    <!-- Close -->
                    <Button Classes="DockClose"
                            Command="{Binding ActiveTab.CloseCommand}"
                            IsVisible="{Binding ActiveTab.CanClose}"
                    >
                        <controls:FASymbolIcon Symbol="Dismiss"
                                            FontSize="14"
                                            ToolTip.Tip="Close"/>
                    </Button>
                </StackPanel>
            </Border>
        
            <ContentControl Grid.Row="1"
                            VerticalAlignment="Stretch"
                            Content="{Binding ActiveTab.Control}"
                            Classes="BorderedDock AccentSelected"/>
        </Grid>

        <LayoutTransformControl Grid.Column="1"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch">

            <Border Classes="TabBar" 
                    BorderThickness="1,0,0,0"
            >
                <ItemsControl ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate >
                            <StackPanel Orientation="Vertical" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="model:IDockedItem">
                            <docking:Tab DockContainer="{Binding #Dock.DataContext}"
                                        DockedItem="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </LayoutTransformControl>
    </Grid>
    
</UserControl>