<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:attached="clr-namespace:CreationEditor.Avalonia.Attached"
             xmlns:vm="clr-namespace:CreationEditor.Avalonia.ViewModels.Setting.Docking"
             xmlns:model="clr-namespace:CreationEditor.Avalonia.Models.Settings.Docking"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:docking="clr-namespace:CreationEditor.Avalonia.Services.Docking"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:DataType="vm:StartupDocksSettingVM"
             x:Name="Root"
             x:Class="CreationEditor.Avalonia.Views.Setting.Docking.StartupDocksSettingView">
    <StackPanel Spacing="5">
        <controls:FASettingsExpander Header="Startup Docks"
                                     Description="Will be opened when the application starts"
                                     IsExpanded="True">
            <controls:FASettingsExpander.IconSource>
                <controls:FASymbolIconSource Symbol="DockLeft"/>
            </controls:FASettingsExpander.IconSource>

            <DataGrid ItemsSource="{Binding Docks}"
                      Background="{DynamicResource SystemControlTransparentBrush}"
                      GridLinesVisibility="Horizontal"
                      attached:ListShortcuts.Add="{Binding AddStartupDockCommand}"
                      attached:ListShortcuts.Remove="{Binding RemoveStartupDockCommand}"
                      Classes="NoCellSelection Medium Mutable">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Dock Type">
                        <DataTemplate DataType="model:StartupDock">
                            <ComboBox ItemsSource="{Binding #Root.ViewModel.DockableDefinitions}"
                                      SelectedValue="{Binding Identifier}"
                                      SelectedValueBinding="{Binding Type}">
                                <ComboBox.DataTemplates>
                                    <DataTemplate DataType="docking:IDockableDefinition">
                                        <TextBlock Text="{Binding Header}"/>
                                    </DataTemplate>
                                </ComboBox.DataTemplates>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Dock Mode">
                        <DataTemplate DataType="model:StartupDock">
                            <ComboBox ItemsSource="{x:Static vm:StartupDocksSettingVM.DockModeTypes}"
                                      SelectedItem="{Binding DockMode}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Dock Layout">
                        <DataTemplate DataType="model:StartupDock">
                            <ComboBox ItemsSource="{x:Static vm:StartupDocksSettingVM.DockTypes}"
                                      SelectedItem="{Binding Dock}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </controls:FASettingsExpander>
    </StackPanel>
</UserControl>