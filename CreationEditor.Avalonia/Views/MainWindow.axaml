<windowing:FAAppWindow x:Class="CreationEditor.Avalonia.Views.MainWindow"
                       xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:windowing="clr-namespace:FluentAvalonia.UI.Windowing;assembly=FluentAvalonia"
                       xmlns:notificationView="clr-namespace:CreationEditor.Avalonia.Views.Notification"
                       xmlns:docking="clr-namespace:CreationEditor.Avalonia.Views.Docking"
                       xmlns:viewModels="clr-namespace:CreationEditor.Avalonia.ViewModels"
                       xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                       xmlns:notification="clr-namespace:CreationEditor.Services.Notification;assembly=CreationEditor"
                       xmlns:mod="clr-namespace:CreationEditor.Avalonia.Views.Mod"
                       xmlns:dialog="clr-namespace:CreationEditor.Avalonia.Views.Dialog"
                       xmlns:dataSource="clr-namespace:CreationEditor.Avalonia.Views.DataSource"
                       xmlns:search="clr-namespace:CreationEditor.Avalonia.Views.Search"
                       Title="{Binding WindowTitleObs^}"
                       MinHeight="540"
                       MinWidth="960"
                       x:DataType="viewModels:MainVM"
                       x:Name="Window">
    <Grid>
        <DockPanel VerticalAlignment="Stretch"
                   HorizontalAlignment="Stretch"
                   x:Name="DockPanel">
            <Panel DockPanel.Dock="Top"
                   VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <Menu Background="{x:Null}">
                        <MenuItem Header="_File">
                            <MenuItem Header="_Data Sources"
                                      HotKey="Ctrl+Alt+M"
                                      InputGesture="Ctrl+Alt+D"
                                      Command="{Binding #DataSourceSelectionPopup.Show}">
                                <MenuItem.Icon>
                                    <controls:FASymbolIcon Symbol="Folder"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <MenuItem Header="_Mods"
                                      HotKey="Ctrl+Alt+M"
                                      InputGesture="Ctrl+Alt+M"
                                      Command="{Binding #ModSelectionPopup.Show}">
                                <MenuItem.Icon>
                                    <controls:FASymbolIcon Symbol="Save"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <MenuItem Header="_Open">
                                <MenuItem.Icon>
                                    <controls:FASymbolIcon Symbol="Open"/>
                                </MenuItem.Icon>

                                <MenuItem Header="_Game Folder"
                                          Command="{Binding OpenGameFolderCommand}">
                                    <MenuItem.Icon>
                                        <controls:FASymbolIcon Symbol="Message"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <MenuItem Header="_Data Folder"
                                          Command="{Binding OpenDataFolderCommand}">
                                    <MenuItem.Icon>
                                        <controls:FASymbolIcon Symbol="Message"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>

                            <MenuItem Header="Settings"
                                      HotKey="Ctrl+Alt+S"
                                      InputGesture="Ctrl+Alt+S"
                                      Command="{Binding OpenSettingsCommand}">
                                <MenuItem.Icon>
                                    <controls:FASymbolIcon Symbol="Settings"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <MenuItem Header="Integrations"
                                      Command="{Binding OpenIntegrationsCommand}">
                                <MenuItem.Icon>
                                    <controls:FASymbolIcon Symbol="Globe"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <MenuItem Header="Save"
                                      HotKey="Ctrl+S"
                                      InputGesture="Ctrl+S"
                                      Command="{Binding SaveCommand}">
                                <MenuItem.Icon>
                                    <controls:FASymbolIcon Symbol="Save"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                    </Menu>

                    <Menu Background="{x:Null}"
                          ItemsSource="{Binding MenuItems}">
                        <Menu.DataTemplates>
                            <DataTemplate DataType="viewModels:MenuItemVM">
                                <MenuItem Header="{Binding Header}"
                                          Icon="{Binding Icon}"
                                          Command="{Binding OpenCommand}"
                                          HotKey="{Binding HotKey}"
                                          InputGesture="{Binding InputGesture}"
                                          ItemsSource="{Binding Children}"/>
                            </DataTemplate>

                            <DataTemplate DataType="controls:FASymbol">
                                <controls:FASymbolIcon Symbol="{Binding}"/>
                            </DataTemplate>

                            <DataTemplate DataType="controls:FAIconSource">
                                <controls:FAIconSourceElement IconSource="{Binding}"/>
                            </DataTemplate>
                        </Menu.DataTemplates>

                        <Menu.Styles>
                            <Style Selector="Menu MenuItem"
                                   x:DataType="viewModels:MenuItemVM">
                                <Setter Property="Header"
                                        Value="{Binding Header}"/>
                                <Setter Property="Icon"
                                        Value="{Binding Icon}"/>
                                <Setter Property="Command"
                                        Value="{Binding OpenCommand}"/>
                                <Setter Property="HotKey"
                                        Value="{Binding HotKey}"/>
                                <Setter Property="InputGesture"
                                        Value="{Binding InputGesture}"/>
                                <Setter Property="ItemsSource"
                                        Value="{Binding Children}"/>
                            </Style>
                        </Menu.Styles>
                    </Menu>
                </StackPanel>

                <Menu HorizontalAlignment="Right"
                      Margin="0,0,450,0"
                      Background="{x:Null}">
                    <MenuItem HorizontalAlignment="Right"
                              ItemsSource="{Binding MenuItems}">
                        <MenuItem.DataTemplates>
                            <DataTemplate DataType="viewModels:MenuItemVM">
                                <MenuItem Header="{Binding Header}"
                                          Icon="{Binding Icon}"
                                          Command="{Binding OpenCommand}"
                                          HotKey="{Binding HotKey}"
                                          InputGesture="{Binding InputGesture}"
                                          ItemsSource="{Binding Children}"/>
                            </DataTemplate>
                        </MenuItem.DataTemplates>
                    </MenuItem>
                </Menu>

                <Menu HorizontalAlignment="Right"
                      Margin="0,0,150,0"
                      Background="{x:Null}">
                    <MenuItem IsVisible="{Binding !!NotificationVM.LoadingItems.Count}"
                              HorizontalAlignment="Right"
                              ItemsSource="{Binding NotificationVM.LoadingItems}">
                        <MenuItem.Header>
                            <notificationView:NotificationView
                                DataContext="{Binding NotificationVM.LatestNotification^}"/>
                        </MenuItem.Header>

                        <MenuItem.DataTemplates>
                            <DataTemplate DataType="notification:NotificationItem">
                                <notificationView:NotificationView DataContext="{Binding}"/>
                            </DataTemplate>
                        </MenuItem.DataTemplates>
                    </MenuItem>
                </Menu>

                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <search:SearchBarView DataContext="{Binding SearchVM}"/>
                </Border>
            </Panel>

            <Grid>
                <Border DockPanel.Dock="Top"
                        VerticalAlignment="Top"
                        BorderBrush="{DynamicResource ButtonBackground}"
                        Height="2"
                        BorderThickness="0,0,0,2"/>

                <docking:DockingManager DataContext="{Binding DockingManagerService.Root}"/>
            </Grid>
        </DockPanel>

        <dialog:SaveDialog x:Name="ModSelectionPopup"
                           IsVisible="False"
                           Title="Select Mods"
                           DataContext="{Binding ModSelectionVM}">
            <dialog:SaveDialog.Dialog>
                <mod:ModSelectionView DataContext="{Binding}"
                                      DataSourceSelectionPopup="{Binding #DataSourceSelectionPopup}"/>
            </dialog:SaveDialog.Dialog>
        </dialog:SaveDialog>

        <dialog:SaveDialog x:Name="DataSourceSelectionPopup"
                           IsVisible="False"
                           Title="Select Data Sources"
                           CancelEnabledFromStart="True"
                           DataContext="{Binding DataSourceSelectionVM}">
            <dialog:SaveDialog.Dialog>
                <dataSource:DataSourceSelection DataContext="{Binding}"/>
            </dialog:SaveDialog.Dialog>
        </dialog:SaveDialog>
    </Grid>
</windowing:FAAppWindow>