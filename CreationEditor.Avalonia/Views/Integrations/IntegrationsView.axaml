<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:basic="clr-namespace:CreationEditor.Avalonia.Views.Basic;assembly=CreationEditor.Avalonia"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:integrations="clr-namespace:CreationEditor.Avalonia.ViewModels.Integrations"
             xmlns:config="clr-namespace:CreationEditor.Avalonia.Views.Config"
             xmlns:avaloniaProgressRing="clr-namespace:AvaloniaProgressRing;assembly=AvaloniaProgressRing"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:DataType="integrations:IntegrationsVM"
             x:Class="CreationEditor.Avalonia.Views.Integrations.IntegrationsView"
             x:Name="Control">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="200"
                              Width="220"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition MinWidth="200"/>
        </Grid.ColumnDefinitions>

        <!-- Left: integration capabilities -->
        <ListBox Grid.Column="0"
                 ItemsSource="{Binding IntegrationCategories}"
                 SelectedItem="{Binding SelectedIntegrationCategory}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding CategoryName}"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="1"
                                Classes.Gray="{Binding !HasRegistrations}"
                                CornerRadius="10"
                                MinWidth="20"
                                Height="20"
                                Padding="6,0"
                                VerticalAlignment="Center">
                            <Border.Styles>
                                <Style Selector="Border">
                                    <Setter Property="Background"
                                            Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                </Style>
                                <Style Selector="Border.Gray">
                                    <Setter Property="Background"
                                            Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                                </Style>
                                <Style Selector="Border > TextBlock">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                </Style>
                                <Style Selector="Border.Gray > TextBlock">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Style>
                            </Border.Styles>
                            <TextBlock Text="{Binding RegisteredCount}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <GridSplitter Grid.Column="1"/>

        <!-- Right: added integrations + add -->
        <StackPanel Grid.Column="2"
                    Margin="10"
                    Spacing="12">
            <basic:Card Header="Registered Integrations"
                        Description="Tools added for the selected capability"
                        Icon="List">
                <StackPanel Spacing="8">
                    <Button Content="Update All"
                            Classes="accent"
                            Command="{Binding #Control.ViewModel.UpdateAllCommand}"
                            IsVisible="{Binding HasUpdates}"
                            HorizontalAlignment="Right"
                            Padding="12,8"
                            CornerRadius="8"/>
                    <ItemsControl ItemsSource="{Binding RegisteredIntegrations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="CardNested"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,4">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="8">
                                            <StackPanel Grid.Column="0"
                                                        Spacing="2">
                                                <TextBlock Text="{Binding Descriptor.DisplayName}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Descriptor.Description}"
                                                           Opacity="0.6"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="8"
                                                            IsVisible="{Binding HasSource}">
                                                    <TextBlock Text="{Binding SourceName}"
                                                               Opacity="0.6"
                                                               FontSize="12"/>
                                                    <TextBlock Text="{Binding InstalledVersion}"
                                                               Opacity="0.6"
                                                               FontSize="12"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="4"
                                                        VerticalAlignment="Center">
                                                <Button ToolTip.Tip="Check for update"
                                                        Command="{Binding CheckForUpdateCommand}"
                                                        IsVisible="{Binding HasSource}"
                                                        Padding="8"
                                                        Height="32"
                                                        Width="32"
                                                        CornerRadius="8">
                                                    <controls:FASymbolIcon Symbol="Refresh"
                                                                           FontSize="14"/>
                                                </Button>
                                                <Button ToolTip.Tip="Update"
                                                        Classes="accent"
                                                        Command="{Binding UpdateCommand}"
                                                        IsVisible="{Binding UpdateAvailable}"
                                                        Padding="8"
                                                        Height="32"
                                                        Width="32"
                                                        CornerRadius="8">
                                                    <controls:FASymbolIcon Symbol="Download"
                                                                           FontSize="14"/>
                                                </Button>
                                                <Button ToolTip.Tip="Remove"
                                                        Command="{Binding #Control.ViewModel.UnregisterIntegrationCommand}"
                                                        CommandParameter="{Binding}"
                                                        Padding="8"
                                                        Height="32"
                                                        Width="32"
                                                        CornerRadius="8">
                                                    <TextBlock Text="&#10005;"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="IndianRed"
                                                               VerticalAlignment="Center"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding StatusMessage}"
                                                   IsVisible="{Binding StatusMessage}"
                                                   Opacity="0.7"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No integrations registered for this capability."
                               IsVisible="{Binding !RegisteredIntegrations.Count}"
                               Opacity="0.6"/>
                </StackPanel>
            </basic:Card>

            <!-- Add Integration section (hidden when nothing left to add) -->
            <basic:Card Header="Add Integration"
                        Description="Pick an available implementation to add"
                        Icon="Add"
                        IsVisible="{Binding AvailableImplementations.Count}">
                <ItemsControl ItemsSource="{Binding AvailableImplementations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="CardNested"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,4">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto,Auto"
                                          ColumnSpacing="8">
                                        <StackPanel Grid.Column="0"
                                                    Spacing="2">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Opacity="0.6"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                ToolTip.Tip="Register"
                                                Classes="accent"
                                                Command="{Binding BeginRegistrationCommand}"
                                                IsVisible="{Binding !IsAdding}"
                                                Padding="8"
                                                CornerRadius="8"
                                                VerticalAlignment="Center">
                                            <controls:FASymbolIcon Symbol="Add"
                                                                   FontSize="14"/>
                                        </Button>

                                        <Button Grid.Column="2"
                                                ToolTip.Tip="Download and install from the integration's source"
                                                Command="{Binding InstallFromSourceCommand}"
                                                IsVisible="{Binding HasSource}"
                                                IsEnabled="{Binding !IsBusy}"
                                                Margin="4,0,0,0"
                                                Padding="8"
                                                CornerRadius="8"
                                                VerticalAlignment="Center">
                                            <Panel>
                                                <controls:FASymbolIcon Symbol="Download"
                                                                       FontSize="14"
                                                                       IsVisible="{Binding !IsBusy}"/>
                                                <avaloniaProgressRing:ProgressRing IsVisible="{Binding IsBusy}"
                                                        IsActive="{Binding IsBusy}"
                                                        Width="16"
                                                        Height="16"/>
                                            </Panel>
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="{Binding StatusMessage}"
                                               IsVisible="{Binding StatusMessage}"
                                               Opacity="0.7"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>

                                    <!-- Install path picker + confirm, shown inline as one unit -->
                                    <StackPanel IsVisible="{Binding IsAdding}"
                                                Spacing="8">
                                        <!-- Registration Config -->
                                        <config:ConfigView DataContext="{Binding SettingsVM}"/>

                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8">
                                            <Button Content="Add"
                                                    Classes="accent"
                                                    Command="{Binding ConfirmRegistrationCommand}"
                                                    Padding="12,8"
                                                    CornerRadius="8"/>
                                            <Button Content="Cancel"
                                                    Command="{Binding CancelRegistrationCommand}"
                                                    Padding="12,8"
                                                    CornerRadius="8"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </basic:Card>
        </StackPanel>
    </Grid>
</UserControl>