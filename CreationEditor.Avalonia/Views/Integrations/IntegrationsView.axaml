<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:basic="clr-namespace:CreationEditor.Avalonia.Views.Basic;assembly=CreationEditor.Avalonia"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:file="clr-namespace:CreationEditor.Avalonia.Views.Asset.Picker.File;assembly=CreationEditor.Avalonia"
             xmlns:integrations="clr-namespace:CreationEditor.Avalonia.ViewModels.Integrations"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="integrations:IntegrationsVM"
             x:Class="CreationEditor.Avalonia.Views.Integrations.IntegrationsView"
             x:Name="Control">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="200" Width="220"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition MinWidth="200"/>
        </Grid.ColumnDefinitions>

        <!-- Left: integration capabilities -->
        <ListBox Grid.Column="0"
                 ItemsSource="{Binding IntegrationTypes}"
                 SelectedItem="{Binding SelectedIntegrationType}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding CategoryName}"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="1"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="10"
                                MinWidth="20"
                                Height="20"
                                Padding="6,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConfiguredCount}"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <GridSplitter Grid.Column="1"/>

        <!-- Right: added integrations + add -->
        <StackPanel Grid.Column="2" Margin="10" Spacing="12">
            <basic:Card Header="Configured Integrations"
                        Description="Tools added for the selected capability"
                        Icon="List">
                <StackPanel Spacing="8">
                    <ItemsControl ItemsSource="{Binding AddedIntegrations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="CardNested"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,4">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Opacity="0.6"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding InstallPath}"
                                                       Opacity="0.5"
                                                       FontSize="11"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Remove"
                                                Command="{Binding #Control.ViewModel.RemoveIntegrationCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="8"
                                                CornerRadius="8"
                                                VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No integrations configured for this capability."
                               IsVisible="{Binding !AddedIntegrations.Count}"
                               Opacity="0.6"/>
                </StackPanel>
            </basic:Card>

            <!-- Add Integration section (hidden when nothing left to add) -->
            <basic:Card Header="Add Integration"
                        Description="Pick an available implementation to add"
                        Icon="Add"
                        IsVisible="{Binding AvailableImplementations.Count}">
                <ItemsControl ItemsSource="{Binding AvailableImplementations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="CardNested"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,4">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Opacity="0.6"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                ToolTip.Tip="Add"
                                                Classes="accent"
                                                Command="{Binding BeginAddCommand}"
                                                IsVisible="{Binding !IsAdding}"
                                                Padding="8"
                                                CornerRadius="8"
                                                VerticalAlignment="Top">
                                            <controls:FASymbolIcon Symbol="Add"
                                                                   FontSize="14"/>
                                        </Button>
                                    </Grid>

                                    <!-- Install path picker + confirm, shown inline as one unit -->
                                    <StackPanel IsVisible="{Binding IsAdding}" Spacing="8">
                                        <basic:LabeledContentControl Header="Install Path"
                                                                     HeaderToolTip="Path to the installed tool executable">
                                            <file:TextFilePicker FilePath="{Binding InstallPath, Mode=TwoWay}"
                                                                 Title="Select the tool executable"
                                                                 MinWidth="260"/>
                                        </basic:LabeledContentControl>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Add"
                                                    Classes="accent"
                                                    Command="{Binding ConfirmAddCommand}"
                                                    IsEnabled="{Binding CanAdd}"
                                                    Padding="12,8"
                                                    CornerRadius="8"/>
                                            <Button Content="Cancel"
                                                    Command="{Binding CancelAddCommand}"
                                                    Padding="12,8"
                                                    CornerRadius="8"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </basic:Card>
        </StackPanel>
    </Grid>
</UserControl>
