<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:analyzer="clr-namespace:CreationEditor.Avalonia.Views.Analyzer"
             xmlns:analyzer1="clr-namespace:CreationEditor.Avalonia.ViewModels.Analyzer"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="CreationEditor.Avalonia.Views.Analyzer.AnalyzerResultView"
             x:Name="Control"
             x:DataType="analyzer1:AnalyzerResultVM">
    <StackPanel Margin="12,6,8,6"
                Spacing="4">
        <analyzer:AnalyzerResultTitleView/>

        <analyzer:AnalyzerResultContentView/>
    </StackPanel>
</UserControl>