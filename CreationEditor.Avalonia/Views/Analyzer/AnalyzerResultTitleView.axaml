<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:converter="clr-namespace:CreationEditor.Avalonia.Converter"
             xmlns:analyzer="clr-namespace:CreationEditor.Avalonia.ViewModels.Analyzer"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="CreationEditor.Avalonia.Views.Analyzer.AnalyzerResultTitleView"
             x:Name="Control"
             x:DataType="analyzer:AnalyzerResultVM">
    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <!-- Severity -->
        <TextBlock Grid.Column="0"
                   Text="{Binding Result.Topic.Severity}"
                   Margin="0,0,6,0"
                   VerticalAlignment="Center"
                   FontSize="11"
                   FontWeight="Bold"
                   Foreground="{Binding Result.Topic.Severity, Converter={x:Static converter:SeverityConverters.ToSolidBrush}}"/>

        <!-- Record Type -->
        <Border Grid.Column="1"
                CornerRadius="2"
                Padding="4,2"
                Margin="0,0,6,0"
                VerticalAlignment="Top"
                Background="Gray">
            <TextBlock Text="{Binding Result.Record?.Type, Converter={x:Static converter:RecordTypeConverters.ToName}}"
                       FontSize="11"
                       Foreground="Black"
                       FontWeight="Bold"/>
        </Border>

        <!-- Topic Title -->
        <Button Grid.Column="2"
                Background="Transparent"
                BorderThickness="0"
                Padding="2"
                Content="{Binding Result.Topic.TopicDefinition.Title}"
                FontSize="11"
                FontWeight="Medium"
                Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
                VerticalAlignment="Center"/>

        <!-- Metadata -->
        <Button Grid.Column="3"
                IsVisible="{Binding !!Result.Topic.MetaData.Length}"
                FontSize="12"
                Padding="4, 0"
                Background="Transparent"
                BorderThickness="0"
                VerticalAlignment="Center">
            <!-- <Button.Flyout> -->
            <!--     <Flyout FlyoutPresenterClasses="Flyout1000x250"> -->
            <!--         <TableView -->
            <!--             ItemsSource="{Binding Topic.MetaData}"> -->
            <!--             <TableView.Columns> -->
            <!--                 <TableViewColumn Header="Name" -->
            <!--                     Width="200" -->
            <!--                     Binding="{Binding Converter={x:Static converter:MetaDataConverters.ToName}}"/> -->
            <!--                 <TableViewColumn Header="Value" -->
            <!--                     Width="750" -->
            <!--                     Binding="{Binding Converter={x:Static converter:MetaDataConverters.ToValue}}"> -->
            <!--                     <TableViewColumn.CellTemplate> -->
            <!--                         <DataTemplate> -->
            <!--                             <TextBlock -->
            <!--                                 Text="{Binding Converter={x:Static converter:MetaDataConverters.ToValue}}" -->
            <!--                                 TextWrapping="Wrap"/> -->
            <!--                         </DataTemplate> -->
            <!--                     </TableViewColumn.CellTemplate> -->
            <!--                 </TableViewColumn> -->
            <!--             </TableView.Columns> -->
            <!--         </TableView> -->
            <!--     </Flyout> -->
            <!-- </Button.Flyout> -->

            <controls:FAFontIcon Glyph="ℹ️"
                                 FontSize="12"
                                 ToolTip.Tip="{Binding Result.Topic.MetaData, Converter={x:Static converter:MetaDataConverters.ToString}}"/>
        </Button>
    </Grid>
</UserControl>