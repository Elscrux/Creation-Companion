<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:basic="clr-namespace:CreationEditor.Avalonia.Views.Basic;assembly=CreationEditor.Avalonia"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:converter="clr-namespace:ReleasePipeline.Resources.Converter"
             xmlns:viewModels="clr-namespace:ReleasePipeline.ViewModels"
             xmlns:avaloniaProgressRing="clr-namespace:AvaloniaProgressRing;assembly=AvaloniaProgressRing"
             xmlns:analyzer="clr-namespace:CreationEditor.Avalonia.Views.Analyzer;assembly=CreationEditor.Avalonia"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="500"
             x:Class="ReleasePipeline.Views.ChecksStepView"
             x:DataType="viewModels:ChecksStepVM">
    <Grid RowDefinitions="*,Auto"
          RowSpacing="10">
        <basic:Card Grid.Row="0"
                    Header="Pre-release Checks"
                    Description="Run the fixed check suite against the selected mod"
                    Icon="Checkmark">
            <Grid RowDefinitions="Auto,*"
                  RowSpacing="12">
                <!-- Run Checks Button -->
                <Button Grid.Row="0"
                        Command="{Binding RunChecksCommand}"
                        IsEnabled="{Binding !!PipelineContext}"
                        Padding="12,8"
                        CornerRadius="8"
                        HorizontalAlignment="Left">
                    <Button.Content>
                        <Panel>
                            <TextBlock Text="Run Checks"
                                       IsVisible="{Binding !RunChecksCommand.IsExecuting^}"/>

                            <avaloniaProgressRing:ProgressRing IsActive="{Binding RunChecksCommand.IsExecuting^}"
                                                               Height="20"
                                                               Width="20"/>
                        </Panel>
                    </Button.Content>
                </Button>

                <!-- Checks -->
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding CheckItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="CardNested"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,4">
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="8">
                                        <!-- Check Icon -->
                                        <controls:FASymbolIcon Grid.Column="0"
                                                               Symbol="{Binding Status, Converter={x:Static converter:CheckStatusConverters.ToSymbol}}"
                                                               Foreground="{Binding Status, Converter={x:Static converter:CheckStatusConverters.ToBrush}}"
                                                               FontSize="18"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,12,0"/>

                                        <StackPanel Grid.Column="1"
                                                    Spacing="2">
                                            <!-- Check Name -->
                                            <TextBlock Text="{Binding Name}"
                                                       IsVisible="{Binding !Results.Count}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock IsVisible="{Binding !!Results.Count}"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} ({1})">
                                                        <Binding Path="Name"/>
                                                        <Binding Path="Results.Count"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>

                                            <!-- Check Results -->
                                            <ScrollViewer MaxHeight="300">
                                                <ItemsControl ItemsSource="{Binding Results}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <analyzer:AnalyzerResultContentView/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>

                                        <!-- Status -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Status}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </basic:Card>

        <basic:Card Grid.Row="1"
                    Header="Blocking Failures"
                    Description="Some checks failed. You can acknowledge them and continue anyway."
                    Icon="Alert"
                    IsVisible="{Binding HasBlockingCheckFailures}">
            <CheckBox Content="Continue anyway despite failing checks"
                      IsChecked="{Binding ContinueAnyway}"/>
        </basic:Card>
    </Grid>
</UserControl>