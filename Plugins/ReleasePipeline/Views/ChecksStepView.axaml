<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:basic="clr-namespace:CreationEditor.Avalonia.Views.Basic;assembly=CreationEditor.Avalonia"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:converter="clr-namespace:ReleasePipeline.Resources.Converter"
             xmlns:viewModels="clr-namespace:ReleasePipeline.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="500"
             x:Class="ReleasePipeline.Views.ChecksStepView"
             x:DataType="viewModels:ChecksStepVM">
    <StackPanel Spacing="10">
        <basic:Card Header="Pre-release Checks"
                    Description="Run the fixed check suite against the selected mod"
                    Icon="Checkmark">
            <StackPanel Spacing="12">
                <Button Content="Run Checks"
                        Command="{Binding RunChecksCommand}"
                        IsEnabled="{Binding !!ReleaseContext}"
                        Padding="12,8"
                        CornerRadius="8"
                        HorizontalAlignment="Left"/>

                <ItemsControl ItemsSource="{Binding CheckItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="CardNested"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,4">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <controls:FASymbolIcon Grid.Column="0"
                                                           Symbol="{Binding Status, Converter={x:Static converter:CheckStatusConverters.ToSymbol}}"
                                                           Foreground="{Binding Status, Converter={x:Static converter:CheckStatusConverters.ToBrush}}"
                                                           FontSize="18"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Message}"
                                                   Opacity="0.6"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   IsVisible="{Binding !!Message}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Status}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </basic:Card>

        <basic:Card Header="Blocking Failures"
                    Description="Some checks failed. You can acknowledge them and continue anyway."
                    Icon="Alert"
                    IsVisible="{Binding HasBlockingCheckFailures}">
            <CheckBox Content="Continue anyway despite failing checks"
                      IsChecked="{Binding ContinueAnyway}"/>
        </basic:Card>
    </StackPanel>
</UserControl>
