<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:basic="clr-namespace:CreationEditor.Avalonia.Views.Basic;assembly=CreationEditor.Avalonia"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:converter="clr-namespace:ReleasePipeline.Resources.Converter"
             xmlns:viewModels="clr-namespace:ReleasePipeline.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="600"
             d:DesignHeight="500"
             x:Class="ReleasePipeline.Views.PipelineRunView"
             x:DataType="viewModels:PipelineRunVM"
             x:Name="Control">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">
            <!-- Run status card -->
            <basic:Card Header="Run Status"
                        Description="Live progress of the pipeline run"
                        Icon="Play">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <ProgressBar Minimum="0"
                                     Maximum="{Binding TotalSteps}"
                                     Value="{Binding CompletedSteps}"
                                     Height="20"
                                     CornerRadius="8"/>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Opacity="0.7">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} / {1}">
                                    <Binding Path="CompletedSteps"/>
                                    <Binding Path="TotalSteps"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding IsRunning, Converter={x:Static converter:RunStatusConverters.ToRunStateText}}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Succeeded, Converter={x:Static converter:RunStatusConverters.ToResultText}}"
                                   Opacity="0.7"/>
                    </StackPanel>

                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            IsVisible="{Binding IsRunning}"
                            Padding="12,8"
                            CornerRadius="8"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </basic:Card>

            <!-- Actions runtime list -->
            <basic:Card Header="Actions"
                        Description="Each action's live state while the pipeline runs"
                        Icon="List">
                <ItemsControl ItemsSource="{Binding ActionRuns}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="CardNested"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,4">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <controls:FASymbolIcon Grid.Column="0"
                                                           Symbol="{Binding Status, Converter={x:Static converter:RunStatusConverters.ToSymbol}}"
                                                           Foreground="{Binding Status, Converter={x:Static converter:RunStatusConverters.ToBrush}}"
                                                           FontSize="16"
                                                           VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}"
                                                   Opacity="0.6"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding Message}"
                                                   IsVisible="{Binding Message, Converter={x:Static converter:RunStatusConverters.HasMessage}}"
                                                   Opacity="0.8"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Status, Converter={x:Static converter:RunStatusConverters.ToStatusText}}"
                                               VerticalAlignment="Center"
                                               Opacity="0.7"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </basic:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
