<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:basic="clr-namespace:CreationEditor.Avalonia.Views.Basic;assembly=CreationEditor.Avalonia"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:converter="clr-namespace:ReleasePipeline.Resources.Converter"
             xmlns:avaloniaProgressRing="clr-namespace:AvaloniaProgressRing;assembly=AvaloniaProgressRing"
             xmlns:views="clr-namespace:ReleasePipeline.Views"
             xmlns:viewModels="clr-namespace:ReleasePipeline.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="600"
             x:Class="ReleasePipeline.Views.PipelineSelectionStepView"
             x:DataType="viewModels:PipelineSelectionStepVM"
             x:Name="Control">
    <Grid ColumnDefinitions="2*,3*"
          ColumnSpacing="12">
        <!-- Left: pipeline card list (narrower) -->
        <basic:Card Grid.Column="0"
                    Header="Pipelines"
                    Description="Select a pipeline to edit or run"
                    Icon="List">
            <StackPanel Spacing="8">
                <Button Content="Run All"
                        Classes="accent"
                        Command="{Binding RunAllCommand}"
                        Padding="12,8"
                        CornerRadius="8"
                        HorizontalAlignment="Left"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Pipelines}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- New Pipeline add card -->
                                <Border Classes="CardNested"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="4"
                                        MinWidth="180"
                                        MinHeight="150"
                                        IsVisible="{Binding IsAddCard}"
                                        Background="{DynamicResource CardBackgroundFillColorDefault}">
                                    <Button Command="{Binding #Control.ViewModel.AddPipelineCommand}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <StackPanel Spacing="8"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <controls:FASymbolIcon Symbol="Add"
                                                                   FontSize="32"
                                                                   HorizontalAlignment="Center"/>
                                            <TextBlock Text="New Pipeline"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Border>

                                <!-- Pipeline card -->
                                <Border Classes="CardNested"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="4"
                                        MinWidth="180"
                                        MinHeight="150"
                                        IsVisible="{Binding !IsAddCard}"
                                        Background="{Binding IsSelected, Converter={x:Static converter:SelectionConverters.ToActiveBrush}}">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                                        <!-- Title + delete X -->
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="16"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="1"
                                                    Content="&#10005;"
                                                    ToolTip.Tip="Delete"
                                                    Command="{Binding #Control.ViewModel.DeletePipelineCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="4"
                                                    MinWidth="24"
                                                    MinHeight="24"
                                                    CornerRadius="4"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    VerticalAlignment="Top"/>
                                        </Grid>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding ActionCount, StringFormat='{}{0} action(s)'}"
                                                   Opacity="0.6"
                                                   FontSize="12"/>

                                        <!-- Run progress (compact) -->
                                        <ProgressBar Grid.Row="2"
                                                     Minimum="0"
                                                     Maximum="{Binding TotalSteps}"
                                                     Value="{Binding CompletedSteps}"
                                                     IsVisible="{Binding HasRun}"
                                                     Height="6"
                                                     CornerRadius="3"
                                                     Width="150"
                                                     HorizontalAlignment="Left"/>

                                        <!-- Run / Cancel + Edit -->
                                        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                            <Button Grid.Column="0"
                                                    Command="{Binding StartCommand}"
                                                    CommandParameter="{Binding #Control.ViewModel}"
                                                    IsVisible="{Binding !IsRunning}"
                                                    Classes="accent"
                                                    Padding="8"
                                                    CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <controls:FASymbolIcon Symbol="Play"
                                                                           FontSize="14"
                                                                           Foreground="ForestGreen"/>
                                                    <TextBlock Text="Run"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="0"
                                                    IsVisible="{Binding IsRunning}"
                                                    Padding="8"
                                                    CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <avaloniaProgressRing:ProgressRing Width="16" Height="16"/>
                                                    <TextBlock Text="Running"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    ToolTip.Tip="Edit"
                                                    Command="{Binding #Control.ViewModel.EditPipelineCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding !IsRunning}"
                                                    Padding="8"
                                                    CornerRadius="8">
                                                <controls:FASymbolIcon Symbol="Edit"
                                                                       FontSize="16"/>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </basic:Card>

        <!-- Right: inline editor or runtime view -->
        <Grid Grid.Column="1">
            <!-- Placeholder when nothing is selected -->
            <Border IsVisible="{Binding !HasSelection}"
                    Background="{DynamicResource CardBackgroundFillColorDefault}"
                    CornerRadius="8">
                <StackPanel Spacing="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <controls:FASymbolIcon Symbol="Add"
                                           FontSize="40"
                                           Opacity="0.4"
                                           HorizontalAlignment="Center"/>
                    <TextBlock Text="Select a pipeline to edit or run it"
                               Opacity="0.6"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Editor (idle) -->
            <views:ReleasePipelineEditorView DataContext="{Binding EditorVM}"
                                             IsVisible="{Binding #Control.ViewModel.ShowEditor}"/>

            <!-- Runtime view (running) -->
            <views:PipelineRunView DataContext="{Binding SelectedRun}"
                                   IsVisible="{Binding #Control.ViewModel.ShowRun}"/>
        </Grid>
    </Grid>
</UserControl>


