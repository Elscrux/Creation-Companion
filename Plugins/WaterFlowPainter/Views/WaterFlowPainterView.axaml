<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:WaterFlowPainter.ViewModels"
             xmlns:views="clr-namespace:WaterFlowPainter.Views"
             xmlns:services="clr-namespace:WaterFlowPainter.Services"
             xmlns:basic="clr-namespace:CreationEditor.Avalonia.Views.Basic;assembly=CreationEditor.Avalonia"
             xmlns:config="clr-namespace:CreationEditor.Avalonia.Views.Config;assembly=CreationEditor.Avalonia"
             xmlns:record="clr-namespace:CreationEditor.Avalonia.Views.Record.Picker;assembly=CreationEditor.Avalonia"
             xmlns:constants="clr-namespace:CreationEditor.Skyrim.Avalonia.Resources.Constants;assembly=Creation Companion"
             xmlns:converters="clr-namespace:CreationEditor.Avalonia.Converter;assembly=CreationEditor.Avalonia"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:avaloniaProgressRing="clr-namespace:AvaloniaProgressRing;assembly=AvaloniaProgressRing"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="700"
             x:Class="WaterFlowPainter.Views.WaterFlowPainterView"
             x:DataType="viewModels:WaterFlowPainterVM"
             x:Name="View">
    <Grid Margin="5"
          ColumnDefinitions="*,5,340">

        <!-- Worldspace Canvas -->
        <Grid Grid.Column="0"
              RowDefinitions="Auto,5,*"
              VerticalAlignment="Top"
              MinHeight="200">
            <!-- Worldspace Selection -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="5,0"
                           Text="Worldspace:"/>

                <record:FormKeyPicker Grid.Column="1"
                                      VerticalAlignment="Center"
                                      FormKey="{Binding WorldspaceFormKey}"
                                      ScopedTypes="{x:Static constants:RecordTypeConstants.WorldspaceTypes}"
                                      LinkCache="{Binding LinkCacheProvider.LinkCacheChanged^}"/>

                <avaloniaProgressRing:ProgressRing Grid.Column="3"
                                                   Width="25"
                                                   Height="25"
                                                   IsActive="{Binding IsBusy}"/>
            </Grid>

            <!-- Canvas -->
            <Grid Grid.Row="2"
                  Margin="5">
                <Border BorderThickness="5"
                        BorderBrush="{DynamicResource SystemAccentColor}"
                        CornerRadius="5">
                    <ZoomBorder Stretch="Uniform"
                                ZoomSpeed="1.2"
                                AutoCalculateMinZoom="True"
                                ClipToBounds="True"
                                Focusable="True"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch">

                        <!-- The canvas is exactly the composite pixel size so all overlays stay
                             aligned 1:1 with the map and scale together when zooming. It is centered
                             by layout, which the zoom border's fit expects. -->
                        <Grid Width="{Binding CompositeWidth}"
                              Height="{Binding CompositeHeight}">
                            <Image x:Name="FlowPreview"
                                   Source="{Binding FlowPreviewImage}"
                                   Stretch="None"/>

                            <views:WaterFlowCanvasOverlay/>
                        </Grid>
                    </ZoomBorder>
                </Border>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1"/>

        <!-- Tool Panel -->
        <Grid Grid.Column="2"
              RowDefinitions="Auto,5,Auto,5,*">

            <controls:FACommandBar Grid.Row="0"
                                   DefaultLabelPosition="Right">
                <controls:FACommandBar.PrimaryCommands>
                    <controls:FACommandBarButton IconSource="Save"
                                                 Label="Save All"
                                                 IsCompact="False"
                                                 Command="{Binding SaveAllCommand}"/>

                    <controls:FACommandBarSeparator/>

                    <controls:FACommandBarButton IconSource="Undo"
                                                 Label="Undo"
                                                 IsCompact="False"
                                                 Command="{Binding UndoCommand}"/>
                </controls:FACommandBar.PrimaryCommands>
            </controls:FACommandBar>

            <TextBlock Grid.Row="2"
                       Margin="5,0"
                       Text="{Binding StatusText}"
                       TextWrapping="Wrap"/>

            <ScrollViewer Grid.Row="4"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <basic:Card Header="Overlays"
                                Description="Toggle the visual overlays of the canvas"
                                Icon="Map">
                        <StackPanel Spacing="8">
                            <CheckBox Content="Show Arrows"
                                      IsChecked="{Binding ShowArrows}"/>
                        </StackPanel>
                    </basic:Card>

                    <basic:Card Header="Brush"
                                Description="Paint the flowmap of the selected cell"
                                Icon="Edit">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="5">
                                <RadioButton Content="Direction"
                                             GroupName="BrushMode"
                                             IsChecked="{Binding BrushMode, Converter={x:Static converters:EnumConverters.Equals}, ConverterParameter={x:Static services:FlowBrushMode.Direction}, Mode=OneWay}"
                                             Command="{Binding SetBrushModeCommand}"
                                             CommandParameter="{x:Static services:FlowBrushMode.Direction}"/>
                                <RadioButton Content="Speed"
                                             GroupName="BrushMode"
                                             IsChecked="{Binding BrushMode, Converter={x:Static converters:EnumConverters.Equals}, ConverterParameter={x:Static services:FlowBrushMode.Speed}, Mode=OneWay}"
                                             Command="{Binding SetBrushModeCommand}"
                                             CommandParameter="{x:Static services:FlowBrushMode.Speed}"/>
                                <RadioButton Content="Scale"
                                             GroupName="BrushMode"
                                             IsChecked="{Binding BrushMode, Converter={x:Static converters:EnumConverters.Equals}, ConverterParameter={x:Static services:FlowBrushMode.Scale}, Mode=OneWay}"
                                             Command="{Binding SetBrushModeCommand}"
                                             CommandParameter="{x:Static services:FlowBrushMode.Scale}"/>
                            </StackPanel>

                            <basic:LabeledContentControl Header="Size">
                                <Slider Minimum="1"
                                        Maximum="80"
                                        MinWidth="200"
                                        Value="{Binding BrushSize}"/>
                            </basic:LabeledContentControl>

                            <basic:LabeledContentControl Header="Strength">
                                <Slider Minimum="0.05"
                                        Maximum="1"
                                        MinWidth="200"
                                        Value="{Binding BrushStrength}"/>
                            </basic:LabeledContentControl>

                            <basic:LabeledContentControl Header="Speed"
                                                         IsVisible="{Binding BrushMode, Converter={x:Static converters:EnumConverters.Equals}, ConverterParameter={x:Static services:FlowBrushMode.Speed}}">
                                <Slider Minimum="0"
                                        Maximum="1"
                                        MinWidth="200"
                                        Value="{Binding SpeedValue}"/>
                            </basic:LabeledContentControl>

                            <basic:LabeledContentControl Header="Scale"
                                                         IsVisible="{Binding BrushMode, Converter={x:Static converters:EnumConverters.Equals}, ConverterParameter={x:Static services:FlowBrushMode.Scale}}">
                                <Slider Minimum="0"
                                        Maximum="1"
                                        MinWidth="200"
                                        Value="{Binding ScaleValue}"/>
                            </basic:LabeledContentControl>
                        </StackPanel>
                    </basic:Card>

                    <basic:Card Header="Texture Processor"
                                Description="Integration used to convert painted flowmaps into DDS files"
                                Icon="Settings">
                        <config:ConfigView DataContext="{Binding ConfigVM}"/>
                    </basic:Card>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>